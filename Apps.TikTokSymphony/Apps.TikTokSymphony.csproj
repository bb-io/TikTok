<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Product>TikTok Symphony</Product>
        <Description>Generate, translate and dub videos, create digital-avatar presentations, discover inspiration, and retrieve finished assets with TikTok Symphony.</Description>
        <Version>1.1.0</Version>
        <AssemblyVersion>$(Version).0</AssemblyVersion>
        <FileVersion>$(Version).0</FileVersion>
        <InformationalVersion>$(Version)</InformationalVersion>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <AssemblyName>Apps.TikTokSymphony</AssemblyName>
        <PackageId>Apps.TikTokSymphony</PackageId>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Blackbird.Applications.Sdk.Common" Version="2.17.0" />
        <PackageReference Include="Blackbird.Applications.Sdk.Utils" Version="1.1.0-rc.8709" />
        <PackageReference Include="Polly" Version="8.2.0" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="image/icon.png" />
        <None Include="image/tiktok.jpg" />
        <EmbeddedResource Include="../README.md" Link="README.md" CopyToOutputDirectory="Always" />
    </ItemGroup>

    <Target Name="ValidateAppVersion" BeforeTargets="BeforeBuild;PrepareForPublish">
        <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(Version)', '^[0-9]+\.[0-9]+\.[0-9]+$'))"
               Text="Use an increasing numeric major.minor.patch Version for Blackbird uploads. Prerelease suffixes do not distinguish the assembly version." />
        <Error Condition="'$(AssemblyVersion)' != '$(Version).0' Or '$(FileVersion)' != '$(Version).0' Or '$(InformationalVersion)' != '$(Version)'"
               Text="AssemblyVersion and FileVersion must equal Version.0, and InformationalVersion must equal Version." />
    </Target>

    <Target Name="ValidatePreviousReleaseVersion" BeforeTargets="BeforeBuild;PrepareForPublish"
            DependsOnTargets="ValidateAppVersion" Condition="'$(PreviousReleaseVersion)' != ''">
        <Error Condition="$([MSBuild]::VersionLessThanOrEquals('$(Version)', '$(PreviousReleaseVersion)'))"
               Text="Version must be greater than PreviousReleaseVersion. Increase the numeric version before packaging." />
    </Target>

</Project>
